# SkillBridge Backend Environment Variables
# Copy this to .env and fill in actual values

# ── Application ──
APP_ENV=development
SECRET_KEY=CHANGE-ME-use-python-c-import-secrets-print(secrets.token_hex(32))
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──
# Development (SQLite — zero-config local dev)
DATABASE_URL=sqlite+aiosqlite:///./skillbridge.db

# Production (Azure SQL Database — uncomment and fill)
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# ── Azure Blob Storage (for file uploads) ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=skillbridge-uploads

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── File uploads ──
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
